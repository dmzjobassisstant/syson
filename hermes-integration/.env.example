# Environment variables for the Hermes-SysON integration
# Copy to .env and fill in real values.

# Hermes auth token — the SaaS must send this in every request to the gateway.
# Generate a random token: openssl rand -hex 32
HERMES_AUTH_TOKEN=changeme-to-a-long-random-string

# SysON backend auth (admin credentials for the bridge)
SYSON_AUTH_TOKEN=changeme-syson-jwt-or-api-key

# LLM API — DeepSeek (existing endpoint from agent_settings.json)
DEEPSEEK_API_KEY=sk-8f8b399
# Endpoint: https://api.deepseek.com/v1
# Model: deepseek-chat
